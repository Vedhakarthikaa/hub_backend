# =========================
# CixioHub Backend Config
# =========================

DEBUG=true
APP_NAME=CixioHub API

# =========================
# DATABASE
# =========================
DATABASE_URL=postgresql+asyncpg://postgres:admin123@localhost:5432/cixiohub

# =========================
# REDIS (for caching / future queue system)
# =========================
REDIS_URL=redis://localhost:6379/0

# =========================
# JWT AUTH
# =========================
SECRET_KEY=change-this-in-production-use-openssl
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =========================
# OLLAMA (LOCAL AI)
# =========================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# =========================
# AI SERVICE (MICROSERVICE)
# =========================
AI_SERVICE_URL=http://localhost:8003

# =========================
# RABBITMQ (future queue system)
# =========================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# =========================
# FILE STORAGE (MinIO / S3)
# =========================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=cixiohub-uploads

# =========================
# EMAIL (GMAIL SMTP)
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USERNAME=vedhak09@gmail.com
SMTP_PASSWORD=

SMTP_FROM=vedhak09@gmail.com

# =========================
# NOTIFICATION SERVICE
# =========================
NOTIFY_SERVICE_URL=http://localhost:8001

# =========================
# CHROMA DB (VECTOR STORE)
# =========================
CHROMA_HOST=localhost
CHROMA_PORT=8002

# =========================
# GOOGLE AUTH (optional)
# =========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =========================
# FILE UPLOAD LIMIT
# =========================
MAX_UPLOAD_SIZE_MB=50

# =========================
# WEBSOCKET CONFIG (optional future scaling)
# =========================
WEBSOCKET_ENABLED=true